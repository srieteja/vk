PORT=8080
GIN_MODE=debug
ENVIRONMENT=development

DATABASE_URL=postgres://enterprise_user:enterprise_password@localhost:5432/enterprise_db
DB_MAX_CONNECTIONS=25
DB_TIMEOUT=30

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

JWT_SECRET=your-super-secret-jwt-key-change-in-production
TOKEN_EXPIRY=86400

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx

TURN_SERVER=turn:your-turn.com
TURN_USERNAME=user
TURN_PASSWORD=pass

PLATFORM_COMMISSION_PERCENTAGE=20.0
USERB_RATE_PER_MINUTE=5.0
FRONTEND_URL=http://localhost:3000

# LLM Configuration
ANTHROPIC_API_KEY=your_anthropic_key
OPENAI_API_KEY=your_openai_key
# Custom LLM (e.g., Ollama) - Defaults to http://localhost:11434/v1
CUSTOM_LLM_BASE_URL=http://localhost:11434/v1
CUSTOM_LLM_MODEL=llama3
