PORT=8080
GIN_MODE=debug
ENVIRONMENT=development

DATABASE_URL=postgres://srie:qwerty@localhost:5432/vk_db
DB_MAX_CONNECTIONS=25
DB_TIMEOUT=30
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME_SECONDS=300
RUN_MIGRATIONS=true
AUTO_MIGRATE=true
MIGRATIONS_DIR=migrations

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
SESSION_STORE_MODE=hybrid

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

JWT_SECRET=your-super-secret-jwt-key-change-in-production
OAUTH_STATE_SECRET=your-oauth-state-secret-change-in-production
OAUTH_STATE_TTL_SECONDS=600
TOKEN_EXPIRY=86400
IDEMPOTENCY_TTL_SECONDS=86400

# Outbox Worker
OUTBOX_POLL_INTERVAL_SECONDS=5
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_ATTEMPTS=5

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx

TURN_SERVER=turn:your-turn.com
TURN_USERNAME=user
TURN_PASSWORD=pass

PLATFORM_COMMISSION_PERCENTAGE=20.0
USERB_RATE_PER_MINUTE=5.0
FRONTEND_URL=http://localhost:3000
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000

# Observability
METRICS_ENABLED=true
OTEL_SERVICE_NAME=vk_backend
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true

# LLM Configuration
ANTHROPIC_API_KEY=your_anthropic_key
OPENAI_API_KEY=your_openai_key
# Custom LLM (e.g., Ollama) - Defaults to http://localhost:11434/v1
CUSTOM_LLM_BASE_URL=http://localhost:11434/v1
CUSTOM_LLM_MODEL=llama3
